NODE_ENV=production
PUBLIC_ORIGIN=https://YOUR-DOMAIN.example
DB_DRIVER=mysql
MYSQL_HOST=YOUR-MYSQL-HOST
MYSQL_PORT=3306
MYSQL_DATABASE=YOUR-NEW-B-DATABASE
MYSQL_USER=YOUR-B-DATABASE-USER
MYSQL_PASSWORD=
MYSQL_SSL=0
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ORDER_TOKEN_SECRET=
# Optional server-side Meta events. Never put this token in dashboard/frontend.
META_ACCESS_TOKEN=
META_API_VERSION=
# Optional verified Meta Test Events code for staging only.
META_TEST_EVENT_CODE=
# Set only when Hostinger's reverse proxy strips client-supplied forwarded headers.
TRUST_PROXY=0
